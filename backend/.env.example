# "alphavantage" (real data, needs a free key) or "demo" (deterministic SAMPLE data, clearly labelled)
MARKET_DATA_PROVIDER=alphavantage
MARKET_DATA_API_KEY=
# "compact" = last ~100 trading days (free tier). "full" = 20+ years (may need a paid Alpha Vantage plan).
ALPHAVANTAGE_OUTPUTSIZE=compact
# Supabase: used only to VERIFY user tokens and to call the database on the user's behalf (RLS applies).
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=120
